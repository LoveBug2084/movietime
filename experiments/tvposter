#!/usr/bin/env python3
import requests
import sys
import os

TMDB_API_KEY = "6ee1592d2aa6879294c1a8bf597095d1"
IMAGE_BASE = "https://image.tmdb.org/t/p/original"

def search_tv(query):
    url = f"https://api.themoviedb.org/3/search/tv?api_key={TMDB_API_KEY}&query={requests.utils.quote(query)}"
    resp = requests.get(url, timeout=15)
    data = resp.json()
    return data.get("results", [])[0] if data.get("results") else None

def download_image(url, filename):
    if not url:
        return False
    full_url = IMAGE_BASE + url
    try:
        resp = requests.get(full_url, timeout=30)
        if resp.status_code == 200:
            with open(filename, "wb") as f:
                f.write(resp.content)
            print(f"  Downloaded: {filename}")
            return True
    except Exception as e:
        print(f"  Error downloading {filename}: {e}")
    return False

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: ./tvposter \"TV Show Name\"")
        sys.exit(1)
    
    query = " ".join(sys.argv[1:])
    print(f'Searching for: "{query}"')
    
    show = search_tv(query)
    if not show:
        print("TV show not found")
        sys.exit(1)
    
    name = show.get("name", "unknown")
    poster_path = show.get("poster_path")
    backdrop_path = show.get("backdrop_path")
    
    print(f"Found: {name}")
    print("Downloading images...")
    
    safe_name = "".join(c for c in name if c.isalnum() or c in " -").strip()
    
    if poster_path:
        download_image(poster_path, f"{safe_name}_poster.jpg")
    
    if backdrop_path:
        download_image(backdrop_path, f"{safe_name}_backdrop.jpg")
    
    if not poster_path and not backdrop_path:
        print("No images found")
