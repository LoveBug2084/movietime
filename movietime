    if not is_active:
        video_file = find_video_file(info_hash, tmdb_id)
        status = get_torrent_status(tmdb_id, info_hash)

        # Resume incomplete downloads in background even if the file is playable
        resume_download = False
        if status and status.get("magnet") and status.get("name"):
            progress = status.get("progress", 0)
            is_complete = status.get("status") == "completed"
            if not is_complete or progress < 100:
                resume_download = True

        if video_file and is_valid_video_file(video_file):
            with download_lock:
                current_download["handle"] = None
                current_download["info_hash"] = info_hash
                current_download["video_file"] = video_file
                if status:
                    current_download["name"] = status.get("name", "")
            if resume_download:
                threading.Thread(
                    target=download_torrent,
                    args=(status["magnet"], info_hash, status["name"], tmdb_id),
                    daemon=True
                ).start()
        else:
            if resume_download:
                threading.Thread(
                    target=download_torrent, 
                    args=(status["magnet"], info_hash, status["name"], tmdb_id), 
                    daemon=True
                ).start()
                time.sleep(0.2)
                video_file = None
 
    video_file = find_video_file(info_hash, tmdb_id)
 
    if not video_file or not os.path.exists(video_file):
        return jsonify({"error": "No video file"}), 404
 
    valid = is_valid_video_file(video_file)
    file_size = os.path.getsize(video_file) if video_file else 0

    if not valid:
        return jsonify({"error": "Video file not ready"}), 404

    with mpv_lock:
        if mpv_player["process"]:
            try:
                mpv_player["process"].terminate()
                mpv_player["process"].wait(timeout=5)
            except:
                mpv_player["process"].kill()

        try:
            subtitle_files = find_subtitle_files(video_file)

            mpv_args = ["mpv", "--fs", "--quiet", "--no-terminal",
                        "--hwdec=no", "--force-window=yes",
                        "--demuxer-readahead-secs=30", "--sid=no"]

            for sub_file in subtitle_files:
                mpv_args.append(f"--sub-file={sub_file}")

            mpv_args.append(video_file)

            with open(MPV_LOG, "a") as mpv_log:
                mpv_log.write(f"\n[{time.strftime('%Y-%m-%d %H:%M:%S')}] {' '.join(mpv_args)}\n")
                mpv_log.flush()
            mpv_err = open(MPV_LOG, "a")

            proc = subprocess.Popen(
                mpv_args,
                stdout=subprocess.DEVNULL,
                stderr=mpv_err,
                start_new_session=True,
            )
            mpv_player["process"] = proc
            mpv_player["playing"] = True
            mpv_player["title"] = os.path.basename(video_file)
        except Exception as e:
            return jsonify({"error": str(e)}), 500

    return jsonify({"status": "playing", "file": video_file})

