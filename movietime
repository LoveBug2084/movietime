def load_movies_from_cache():
    """Load movies from cache file and populate movie_ids set and in-memory movie_db"""
    global movie_ids, movie_count, movie_db
    
    ensure_database_files()
    recover_from_corruption()
    
    active_movies = load_json_file(CACHE_FILE)
    if active_movies:
        movie_ids = {m["id"] for m in active_movies if "id" in m}
        movie_count = len(active_movies)
        with movie_db_lock:
            movie_db.clear()
            movie_db.extend(active_movies)
        print(f"Loaded {len(active_movies)} movies from cache, {len(movie_ids)} unique IDs")
        return active_movies
    
    building_movies = load_json_file(BUILDING_FILE)
    if building_movies:
        movie_ids = {m["id"] for m in building_movies if "id" in m}
        movie_count = len(building_movies)
        with movie_db_lock:
            movie_db.clear()
            movie_db.extend(building_movies)
        print(f"Loaded {len(building_movies)} movies from building, {len(movie_ids)} unique IDs")
        return building_movies
    
    movie_count = 0
    with movie_db_lock:
        movie_db.clear()
    return []

def ensure_movie_db():
    """Lazily load the movie database into memory exactly once. Returns the in-memory list."""
    global movie_db, movie_by_id, movie_ids, movie_count
    with movie_db_lock:
        if movie_db:
            return movie_db
    with movie_db_load_lock:
        with movie_db_lock:
            if movie_db:
                return movie_db
        ensure_database_files()
        recover_from_corruption()
        loaded = load_json_file(CACHE_FILE)
        if not loaded:
            loaded = load_json_file(BUILDING_FILE)
        if loaded:
            with movie_db_lock:
                if not movie_db:
                    movie_db.extend(loaded)
                    movie_ids = {m["id"] for m in loaded if "id" in m}
                    movie_by_id = {m["id"]: m for m in loaded if "id" in m}
                    movie_count = len(loaded)
            print(f"Loaded {len(loaded)} movies into memory")
    return movie_db

def snapshot_movie_db():
    """Ensure the in-memory DB is loaded, then return a copy of the movie list."""
    ensure_movie_db()
    with movie_db_lock:
        return list(movie_db)

