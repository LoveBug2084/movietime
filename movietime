def fetch_and_cache_popular_movies():
    """Fetch ALL available movies from TMDb and save to cache file"""
    global cache_progress
    MAX_PAGES = 500
    all_movies = []

    print("Building complete movie cache (fetching ALL movies from TMDb)...")
    print("This may take a few minutes...")

    cache_progress = {"pages_fetched": 0, "total_pages": MAX_PAGES, "status": "running"}

    first_page, total_pages = fetch_movie_page(1)
    all_movies.extend(first_page)
    cache_progress["pages_fetched"] = 1
    cache_progress["total_pages"] = min(total_pages, MAX_PAGES)

    print(f"Total pages available: {total_pages}, fetching up to {MAX_PAGES} pages...")

    pages_to_fetch = min(total_pages, MAX_PAGES)

    batch_size = 5
    for batch_start in range(2, pages_to_fetch + 1, batch_size):
        batch_end = min(batch_start + batch_size, pages_to_fetch + 1)
        pages_in_batch = range(batch_start, batch_end)

        futures = {executor.submit(fetch_movie_page, page): page for page in pages_in_batch}

        for future in as_completed(futures):
            try:
                results, _ = future.result()
                all_movies.extend(results)
                cache_progress["pages_fetched"] += 1
            except Exception as e:
                print(f"Error collecting page results: {e}")

        print(f"Fetched {len(all_movies)} movies so far...")

    cache_data = {
        "movies": all_movies,
        "timestamp": time.time(),
        "total": len(all_movies),
        "type": "all"
    }

    try:
        with open(CACHE_FILE, "w") as f:
            json.dump(cache_data, f)
        print(f"Complete cache saved: {len(all_movies)} movies!")
    except Exception as e:
        print(f"Error saving cache: {e}")

    cache_progress["status"] = "complete"

    return cache_data

def load_cached_movies():
    """Load movies from cache file if it exists and is fresh"""
    if not os.path.exists(CACHE_FILE):
        return None

    try:
        with open(CACHE_FILE, "r") as f:
            cache_data = json.load(f)

        age = time.time() - cache_data.get("timestamp", 0)
        if age > CACHE_MAX_AGE:
            print(f"Cache is stale (age: {age/3600:.1f} hours), refreshing...")
            return None

        print(f"Loaded {len(cache_data.get('movies', []))} movies from cache")
        return cache_data
    except Exception as e:
        print(f"Error loading cache: {e}")
        return None

