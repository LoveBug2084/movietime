@app.route("/api/downloads/list")
def api_downloads_list():
    """List all movies with downloads, grouped by tmdb_id with all resolutions"""
    if not os.path.exists(DOWNLOAD_DIR):
        return jsonify([])

    movies = {}
    for tmdb_str in os.listdir(DOWNLOAD_DIR):
        tmdb_dir = os.path.join(DOWNLOAD_DIR, tmdb_str)
        if not os.path.isdir(tmdb_dir):
            continue

        for info_hash in os.listdir(tmdb_dir):
            hash_dir = os.path.join(tmdb_dir, info_hash)
            if not os.path.isdir(hash_dir):
                continue

            status_path = os.path.join(hash_dir, STATUS_FILE_NAME)
            if not os.path.exists(status_path):
                continue

            try:
                with open(status_path) as f:
                    status = json.load(f)
            except:
                continue

            tmdb_id = status.get("tmdb_id") or tmdb_str
            try:
                tmdb_id_int = int(tmdb_id)
            except (ValueError, TypeError):
                tmdb_id_int = None

            resolution = status.get("resolution", extract_resolution(status.get("name", "")))
            size = status.get("total_bytes", 0) or status.get("size", 0)

            last_updated = status.get("last_updated", 0)

            entry = {
                "info_hash": info_hash,
                "progress": status.get("progress", 0),
                "is_playable": status.get("is_playable", False),
                "resolution": resolution,
                "size": str(size),
                "magnet": status.get("magnet", ""),
                "name": status.get("name", ""),
                "dl_status": status.get("status", ""),
                "last_updated": last_updated,
            }

            if tmdb_id_int is not None:
                key = tmdb_id_int
            else:
                key = info_hash
            if key not in movies:
                movie_entry = {"id": tmdb_id_int, "resolutions": [], "last_updated": last_updated}
                if tmdb_id_int is None:
                    movie_entry["id"] = info_hash
                    movie_entry["title"] = status.get("name", "Unknown")
                movies[key] = movie_entry

            movies[key]["resolutions"].append(entry)
            if last_updated > movies[key]["last_updated"]:
                movies[key]["last_updated"] = last_updated

    result = list(movies.values())
    result.sort(key=lambda m: m.get("last_updated", 0), reverse=True)
    return jsonify(result)

@app.route("/api/torrent")
def api_torrent():
    """Get torrent info for a movie (searches magnetz)"""
    query = request.args.get("q", "").strip()
    category = request.args.get("category", "all").strip()
    year = request.args.get("year", "").strip()
    tmdb_id_param = request.args.get("tmdb_id", "").strip()
    if not query:
        return jsonify({"error": "No query"}), 400
    
    futures = {
        executor.submit(search_apibay, query, category, year): "apibay",
        # executor.submit(search_magnetz, query, category, year): "magnetz"
    }
    
    all_torrents = []
    done, _ = wait(futures, timeout=3)
    for future in done:
        try:
            all_torrents.extend(future.result())
        except Exception as e:
            print(f"Error fetching torrents: {e}")
        
    # Deduplicate by info_hash and keep highest seeders
    unique_torrents = {}
    for t in all_torrents:
        ih = t["info_hash"]
        if ih not in unique_torrents:
            unique_torrents[ih] = t
        else:
            current_seeders = int(t["seeders"]) if t["seeders"].isdigit() else 0
            existing_seeders = int(unique_torrents[ih]["seeders"]) if unique_torrents[ih]["seeders"].isdigit() else 0
            if current_seeders > existing_seeders:
                unique_torrents[ih] = t
                
    final_torrents = list(unique_torrents.values())
    # Attach download status from disk — check download/<tmdb_id>/<info_hash>/
    for t in final_torrents:
        ih = t["info_hash"]
        try:
            tmdb_id_int = int(tmdb_id_param) if tmdb_id_param else None
        except (ValueError, TypeError):
            tmdb_id_int = None
        status = get_torrent_status(tmdb_id_int, ih) if tmdb_id_int else find_torrent_status(ih)
        if status:
            t["progress"] = status.get("progress", 0)
            t["is_playable"] = status.get("is_playable", False)
            t["last_updated"] = status.get("last_updated", 0)
            t["dl_status"] = status.get("status", "")
            t["size"] = str(status.get("total_bytes") or status.get("downloaded_bytes") or t.get("size", 0))
        else:
            t["progress"] = 0
            t["is_playable"] = False
            t["last_updated"] = 0
            t["dl_status"] = ""

    # Inject local downloads not in external results
    existing_hashes = {t["info_hash"] for t in final_torrents if t.get("info_hash")}
    try:
        tmdb_id_int = int(tmdb_id_param) if tmdb_id_param else None
    except (ValueError, TypeError):
        tmdb_id_int = None
    if tmdb_id_int is not None:
        tmdb_str = str(tmdb_id_int)
        tmdb_dir = os.path.join(DOWNLOAD_DIR, tmdb_str)
        if os.path.isdir(tmdb_dir):
            for info_hash in os.listdir(tmdb_dir):
                if info_hash in existing_hashes:
                    continue
                hash_dir = os.path.join(tmdb_dir, info_hash)
                if not os.path.isdir(hash_dir):
                    continue
                status_path = os.path.join(hash_dir, STATUS_FILE_NAME)
                if not os.path.isfile(status_path):
                    continue
                try:
                    with open(status_path) as f:
                        status = json.load(f)
                except:
                    continue
                name = status.get("name", "")
                final_torrents.append({
                    "info_hash": info_hash,
                    "name": name,
                    "resolution": extract_resolution(name),
                    "seeders": 0,
                    "size": str(status.get("total_bytes") or status.get("downloaded_bytes") or 0),
                    "progress": status.get("progress", 0),
                    "is_playable": status.get("is_playable", False),
                    "last_updated": status.get("last_updated", 0),
                    "dl_status": status.get("status", ""),
                })

    # Sort by progress descending, then seeders descending
    final_torrents.sort(key=lambda t: (t.get("progress") or 0, int(t.get("seeders") or 0)), reverse=True)
    
    return jsonify(final_torrents)


