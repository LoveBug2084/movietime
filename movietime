    def __init__(self):
        super().__init__()
        def crc8(path):
            try:
                with open(path, "rb") as f:
                    data = f.read()
                return format(zlib.crc32(data), "08x")
            except OSError:
                return "????????"
        crc_backend = crc8(os.path.join(SCRIPT_DIR, "movietime"))
