def get_popular_movies(page=1):
    """Fetch popular movies from TMDb"""
    url = f"https://api.themoviedb.org/3/movie/popular?api_key={TMDB_API_KEY}&language=en-US&page={page}"
    try:
        resp = requests.get(url, timeout=10)
        data = resp.json()
        movies = []
        for m in data.get("results", []):
            movies.append({
                "id": m.get("id"),
                "title": m.get("title"),
                "poster": TMDB_IMAGE_BASE + m.get("poster_path") if m.get("poster_path") else None,
                "overview": m.get("overview", ""),
                "year": m.get("release_date", "")[:4] if m.get("release_date") else "",
                "rating": round(m.get("vote_average", 0), 1) if m.get("vote_average") else None
            })
        return {"movies": movies, "page": data.get("page", 1), "total_pages": data.get("total_pages", 1)}
