def is_valid_video_file(file_path):
    """Check if file has a valid video header"""
    if not file_path or not os.path.exists(file_path):
        return False

    try:
        file_size = os.path.getsize(file_path)
        if file_size < 1024:
            return False

        with open(file_path, "rb") as f:
            header = f.read(4096)

        if len(header) < 4:
            return False

        if header[:4] == b'\x1a\x45\xdf\xa3':
            return True

        if header[:4] == b'RIFF':
            return True

        if header[4:8] == b'ftyp':
            return True

        for i in range(len(header) - 4):
            if header[i:i+4] == b'\x00\x00\x00\x01':
                return True

        non_zero = sum(1 for b in header if b != 0)
        if non_zero < len(header) * 0.1:
            return False

        return True

    except Exception as e:
        print(f"Error checking video file: {e}")
        return False

def update_active_download_status_loop():
    """Background thread to periodically save progress of the active download"""
    last_progress = {}
    while True:
        with download_lock:
            handle = current_download.get("handle")
            info_hash = current_download.get("info_hash")
            video_total_size = current_download.get("video_total_size")

        if handle and handle.is_valid() and info_hash:
            status = handle.status()
            downloaded = status.total_wanted_done
            
            # Use video-specific size for progress if available to avoid "junk" bloat
            total = video_total_size if video_total_size else status.total_wanted
            
            progress = 0
            if total > 0:
                progress = (downloaded * 100) // total

            # Update if progress changed by at least 1% or if it's finished
            if last_progress.get(info_hash) != progress or status.state in (lt.torrent_status.seeding, lt.torrent_status.finished):
                tmdb_id = current_download.get("tmdb_id")
                video_file = find_video_file(info_hash, tmdb_id)
                has_metadata = handle.has_metadata()
                min_required = int(total * HEADER_MIN_PERCENT) if total > 0 and has_metadata else 0
                is_playable = video_file is not None and has_metadata and is_valid_video_file(video_file) and downloaded >= min_required
                
                save_torrent_status(tmdb_id, info_hash, {
                    "progress": int(progress),
                    "downloaded_bytes": downloaded,
                    "total_bytes": total,
                    "status": "completed" if status.state in (lt.torrent_status.seeding, lt.torrent_status.finished) else "downloading",
                    "is_playable": is_playable,
                    "last_updated": time.time(),
                    "magnet": current_download.get("magnet"),
                    "name": current_download.get("name"),
                    "tmdb_id": tmdb_id,
                    "source": current_download.get("source", ""),
                })
                last_progress[info_hash] = progress

        time.sleep(5)


def apply_sequential_priority(handle):
    """Prioritize the video file's pieces so the header downloads first.
    Must be called AFTER metadata has been received.
    Sets non-video files to dont_download and prioritizes video file pieces.
    """
    ti = handle.get_torrent_info()
    if not ti:
        print("Warning: No torrent info available for piece priority")
        return False

    video_exts = {".mp4", ".mkv", ".avi", ".webm", ".mov"}
    best_file = None
    best_size = 0

    files = ti.files()
    for i, f in enumerate(files):
        ext = os.path.splitext(f.path)[-1].lower()
        if ext in video_exts and f.size > best_size:
            best_file = i
            best_size = f.size

    if best_file is None:
        print("Warning: No video file found in torrent, downloading all files")
        return False

    num_pieces = ti.num_pieces()
    piece_length = ti.piece_length()

    file_offset = files[best_file].offset
    file_size = files[best_file].size

    video_start_piece = file_offset // piece_length
    video_end_piece = (file_offset + file_size + piece_length - 1) // piece_length
    video_end_piece = min(video_end_piece, num_pieces)

    for i in range(len(files)):
        if i != best_file:
            handle.file_priority(i, lt.download_priority_t.dont_download)

    handle.file_priority(best_file, lt.download_priority_t.normal_priority)

    for i in range(num_pieces):
        handle.piece_priority(i, 0)

    for i in range(video_start_piece, video_end_piece):
        handle.piece_priority(i, 5)

    header_count = min(10, video_end_piece - video_start_piece)
    for i in range(video_start_piece, video_start_piece + header_count):
        handle.piece_priority(i, 7)

    with download_lock:
        current_download["video_start_piece"] = video_start_piece
        current_download["header_piece_count"] = header_count
        current_download["piece_length"] = piece_length
        current_download["video_total_size"] = best_size

    log_debug(f"[DEBUG priority] Stored: start_piece={video_start_piece}, header_count={header_count}")

    video_file_name = files[best_file].path
    print(f"Applied sequential priority: '{video_file_name}' ({best_size / (1024*1024):.1f} MB)")
    print(f"  Video pieces: {video_start_piece} to {video_end_piece} (of {num_pieces} total)")
    print(f"  Header pieces: {video_start_piece} to {video_start_piece + header_count}")
    print(f"  Non-video files set to dont_download: {len(files) - 1} files")

    return True

