@app.route("/api/status")
def api_status():
    """Check download status with progress using libtorrent"""
    video_file = find_video_file()

    with download_lock:
        handle = current_download["handle"]

    if handle and handle.is_valid():
        status = handle.status()
        progress = status.progress  # 0.0 to 1.0
        total_size = status.total_wanted
        downloaded = status.total_wanted_done
        state = status.state

        is_downloading = state not in (lt.torrent_status.seeding, lt.torrent_status.finished)
        is_complete = state in (lt.torrent_status.seeding, lt.torrent_status.finished)

        # Update video_file reference from libtorrent
        if not video_file and is_complete:
            video_file = find_video_file()

        if video_file:
            file_size = os.path.getsize(video_file)
            valid = is_valid_video_file(video_file)

            if is_complete and valid:
                return jsonify({
                    "status": "ready",
                    "file": video_file,
                    "downloaded_size": file_size,
                    "is_valid": valid,
                    "info_hash": current_download.get("info_hash"),
                })

            return jsonify({
                "status": "downloading",
                "downloaded_size": downloaded if downloaded > 0 else file_size,
                "total_size": total_size,
                "is_valid": valid,
                "complete": is_complete,
                "percent": int(progress * 100),
                "info_hash": current_download.get("info_hash"),
            })
        else:
            return jsonify({
                "status": "downloading",
                "downloaded_size": downloaded,
                "total_size": total_size,
                "is_valid": False,
                "complete": is_complete,
                "percent": int(progress * 100),
                "info_hash": current_download.get("info_hash"),
            })

    if video_file:
        file_size = os.path.getsize(video_file)
        valid = is_valid_video_file(video_file)
        if valid:
            return jsonify({
                "status": "ready",
                "file": video_file,
                "downloaded_size": file_size,
                "is_valid": valid,
            })

    return jsonify({"status": "idle", "is_valid": False})

