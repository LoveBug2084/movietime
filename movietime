def validate_torrent_contents(handle, info_hash, tmdb_id, name):
    """Check torrent file list for video files. Cancel download if none found."""
    video_exts = {".mp4", ".mkv", ".avi", ".webm", ".mov"}
    non_video_exts = {".m4b", ".mp3", ".flac", ".aac", ".ogg", ".wma",
                      ".epub", ".mobi", ".azw3", ".azw", ".cbz", ".cbr",
                      ".pdf", ".txt", ".doc", ".docx"}

    try:
        ti = handle.get_torrent_info()
        if not ti:
            return True

        files = ti.files()
        file_list = []
        for i, f in enumerate(files):
            ext = os.path.splitext(f.path)[-1].lower()
            file_list.append({"path": f.path, "ext": ext, "size": f.size})

        has_video = any(f["ext"] in video_exts for f in file_list)
        if has_video:
            return True

        non_video = [f for f in file_list if f["ext"] in non_video_exts]
        if non_video:
            exts = set(f["ext"] for f in non_video)
            reason = f"Not a movie - torrent contains: {', '.join(sorted(exts))}"
        else:
            exts = set(f["ext"] for f in file_list if f["ext"])
            reason = f"No video files found - torrent contains: {', '.join(sorted(exts))}"

        print(f"Cancelling download: {reason} (hash: {info_hash})")

        try:
            lt_session.remove_torrent(handle, False)
        except:
            pass

        with download_lock:
            current_download["handle"] = None
            current_download["video_file"] = None
            current_download["info_hash"] = None

        last_cancel_reason["reason"] = reason
        last_cancel_reason["info_hash"] = info_hash
        last_cancel_reason["timestamp"] = time.time()

        existing_status = get_torrent_status(tmdb_id, info_hash) or {}
        save_torrent_status(tmdb_id, info_hash, {
            "progress": 0,
            "downloaded_bytes": 0,
            "total_bytes": 0,
            "status": "cancelled",
            "is_playable": False,
            "last_updated": time.time(),
            "magnet": "",
            "name": name,
            "tmdb_id": tmdb_id,
            "cancel_reason": reason,
            "source": existing_status.get("source", current_download.get("source", "")),
        })

        hash_dir = os.path.join(DOWNLOAD_DIR, str(tmdb_id), info_hash)
        if os.path.isdir(hash_dir):
            try:
                shutil.rmtree(hash_dir, ignore_errors=True)
                print(f"Cleaned up invalid torrent files: {hash_dir}")
            except Exception as e:
                print(f"Error cleaning up torrent files: {e}")

        return False

    except Exception as e:
        print(f"Error validating torrent contents: {e}")
        return True


def download_torrent(magnet_link, info_hash, name, tmdb_id=None):
    """Download torrent using libtorrent with sequential piece priority"""
    global current_download
 
    with download_lock:
        # Pause any existing download (keep data so it can resume later)
        if current_download["handle"]:
            try:
                lt_session.remove_torrent(current_download["handle"], False)
            except:
                pass
 
    # Build magnet link with trackers
    tracker_params = "&tr=".join(PUBLIC_TRACKERS)
    if tracker_params:
        magnet_link = magnet_link + "&tr=" + tracker_params
 
    print(f"Starting libtorrent download: {magnet_link[:80]}...")
 
    atp = lt.parse_magnet_uri(magnet_link)
    hash_dir = os.path.join(DOWNLOAD_DIR, str(tmdb_id), info_hash)
    atp.save_path = os.path.abspath(hash_dir)
    os.makedirs(atp.save_path, exist_ok=True)
    atp.storage_mode = lt.storage_mode_t.storage_mode_sparse
    atp.flags |= lt.torrent_flags.sequential_download
 
    handle = lt_session.add_torrent(atp)
    handle.set_upload_limit(0)  # Disable seeding/upload
 
    with download_lock:
        current_download["handle"] = handle
        current_download["info_hash"] = info_hash
        current_download["name"] = name
        current_download["magnet"] = magnet_link
        current_download["video_file"] = None
        current_download["tmdb_id"] = tmdb_id


    # For magnet links, metadata must be downloaded first.
    # Poll until metadata arrives.
    def wait_for_metadata():
        for _ in range(120):
            time.sleep(0.5)
            if handle.has_metadata():
                print(f"Metadata received for: {name}")
                if not validate_torrent_contents(handle, info_hash, tmdb_id, name):
                    return
                apply_sequential_priority(handle)
                return
        print(f"Warning: metadata not received within 60s for: {name}")

    threading.Thread(target=wait_for_metadata, daemon=True).start()

def find_video_file(info_hash, tmdb_id=None):
    """Find the first video file in download/<tmdb_id>/<info_hash>/"""
    if not info_hash:
        return None

    video_exts = [".mp4", ".mkv", ".avi", ".webm", ".mov"]

    if tmdb_id is not None:
        hash_dir = os.path.join(DOWNLOAD_DIR, str(tmdb_id), info_hash)
        if os.path.isdir(hash_dir):
            for root, dirs, files in os.walk(hash_dir):
                for f in files:
                    ext = os.path.splitext(f)[1].lower()
                    if ext in video_exts:
                        full_path = os.path.join(root, f)
                        if os.path.getsize(full_path) > 0:
                            return full_path
        return None

    # Fallback: scan all tmdb dirs
    if not os.path.isdir(DOWNLOAD_DIR):
        return None
    for tmdb_dir in os.listdir(DOWNLOAD_DIR):
        hash_dir = os.path.join(DOWNLOAD_DIR, tmdb_dir, info_hash)
        if not os.path.isdir(hash_dir):
            continue
        for root, dirs, files in os.walk(hash_dir):
            for f in files:
                ext = os.path.splitext(f)[1].lower()
                if ext in video_exts:
                    full_path = os.path.join(root, f)
                    if os.path.getsize(full_path) > 0:
                        return full_path
    return None

def find_subtitle_files(video_path):
    """Find subtitle files in the same directory as the video file"""
    subtitle_exts = [".srt", ".vtt", ".ass", ".ssa", ".sub"]
    video_dir = os.path.dirname(video_path)

    subtitles = []
    for root, dirs, files in os.walk(video_dir):
        for f in files:
            ext = os.path.splitext(f)[1].lower()
            if ext in subtitle_exts:
                subtitles.append(os.path.join(root, f))

    # Sort subtitles so they are passed in a consistent order
    subtitles.sort()
    return subtitles

