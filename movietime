@app.route("/api/open-downloads", methods=["POST"])
def api_open_downloads():
    """Open downloads folder in file manager"""
    import platform
    system = platform.system()
    try:
        if system == "Darwin":
            subprocess.Popen(["open", os.path.abspath(DOWNLOAD_DIR)])
        elif system == "Windows":
            os.startfile(os.path.abspath(DOWNLOAD_DIR))
        else:
            subprocess.Popen(["xdg-open", os.path.abspath(DOWNLOAD_DIR)])
        return jsonify({"status": "ok"})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

