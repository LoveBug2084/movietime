    for tmdb_dir in os.listdir(DOWNLOAD_DIR):
        hash_path = os.path.join(DOWNLOAD_DIR, tmdb_dir, info_hash)
        if os.path.isdir(hash_path):
            shutil.rmtree(hash_path)
            tmdb_path = os.path.join(DOWNLOAD_DIR, tmdb_dir)
            if os.path.isdir(tmdb_path) and not os.listdir(tmdb_path):
                shutil.rmtree(tmdb_path)
            return jsonify({"success": True})

    return jsonify({"error": "Not found"}), 404

@app.route("/api/play", methods=["POST"])
def api_play():
    """Start playing a specific download with mpv, resuming download if necessary"""
    data = request.json or {}
    info_hash = data.get("info_hash")
    tmdb_id = data.get("tmdb_id")
 
    if not info_hash:
        return jsonify({"error": "info_hash required"}), 400
 
    try:
        tmdb_id_int = int(tmdb_id) if tmdb_id else None
    except (ValueError, TypeError):
        tmdb_id_int = None
 
    # Check if this torrent is currently active in the session
    with download_lock:
        is_active = current_download.get("info_hash") == info_hash
 
    if not is_active:
        video_file = find_video_file(info_hash, tmdb_id_int)
        status = get_torrent_status(tmdb_id_int, info_hash)

        # Resume incomplete downloads in background even if the file is playable
        resume_download = False
        if status and status.get("magnet") and status.get("name"):
            progress = status.get("progress", 0)
            is_complete = status.get("status") == "completed"
            if not is_complete or progress < 100:
                resume_download = True

        if video_file and is_valid_video_file(video_file):
            with download_lock:
                current_download["handle"] = None
                current_download["info_hash"] = info_hash
                current_download["video_file"] = video_file
                if status:
                    current_download["name"] = status.get("name", "")
            if resume_download:
                threading.Thread(
                    target=download_torrent,
                    args=(status["magnet"], info_hash, status["name"], tmdb_id_int),
                    daemon=True
                ).start()
        else:
            if resume_download:
                threading.Thread(
                    target=download_torrent, 
                    args=(status["magnet"], info_hash, status["name"], tmdb_id_int), 
                    daemon=True
                ).start()
                time.sleep(0.2)
                video_file = None
 
    video_file = find_video_file(info_hash, tmdb_id_int)
 
    if not video_file or not os.path.exists(video_file):
        return jsonify({"error": "No video file"}), 404
 
    valid = is_valid_video_file(video_file)
    file_size = os.path.getsize(video_file) if video_file else 0

    if not valid:
        return jsonify({"error": "Video file not ready"}), 404

    with mpv_lock:
        if mpv_player["process"]:
            try:
                mpv_player["process"].terminate()
                mpv_player["process"].wait(timeout=5)
            except:
                mpv_player["process"].kill()

        try:
            subtitle_files = find_subtitle_files(video_file)

            mpv_args = ["mpv", "--fs", "--keep-open=yes", "--quiet", "--no-terminal",
                        "--vo=gpu", "--hwdec=no", "--force-window=yes",
                        "--demuxer-readahead-secs=30", "--sid=no"]

            for sub_file in subtitle_files:
                mpv_args.append(f"--sub-file={sub_file}")

            mpv_args.append(video_file)

            proc = subprocess.Popen(
                mpv_args,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            mpv_player["process"] = proc
            mpv_player["playing"] = True
            mpv_player["title"] = os.path.basename(video_file)
        except Exception as e:
            return jsonify({"error": str(e)}), 500

    return jsonify({"status": "playing", "file": video_file})

@app.route("/api/play/status")
def api_play_status():
    """Get mpv playback status"""
    with mpv_lock:
        proc = mpv_player["process"]
        if proc and proc.poll() is not None:
            mpv_player["playing"] = False
            mpv_player["process"] = None
        return jsonify({
            "playing": mpv_player["playing"],
            "title": mpv_player["title"],
        })

