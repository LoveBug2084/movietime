@app.route("/api/status")
def api_status():
    """Check download status with progress using libtorrent"""
    video_file = find_video_file()

    with download_lock:
        handle = current_download["handle"]

    if handle and handle.is_valid():
        status = handle.status()
        progress = status.progress  # 0.0 to 1.0
        total_size = status.total_wanted
        downloaded = status.total_wanted_done
        state = status.state

        is_downloading = state not in (lt.torrent_status.seeding, lt.torrent_status.finished)
        is_complete = state in (lt.torrent_status.seeding, lt.torrent_status.finished)

        # Update video_file reference from libtorrent
        if not video_file and is_complete:
            video_file = find_video_file()

        if video_file:
            file_size = os.path.getsize(video_file)
            valid = is_valid_video_file(video_file)

            if is_complete and valid:
                return jsonify({
                    "status": "ready",
                    "file": video_file,
                    "downloaded_size": file_size,
                    "is_valid": valid,
                    "info_hash": current_download.get("info_hash"),
                })

            return jsonify({
                "status": "downloading",
                "downloaded_size": downloaded if downloaded > 0 else file_size,
                "total_size": total_size,
                "is_valid": valid,
                "complete": is_complete,
                "percent": int(progress * 100),
                "info_hash": current_download.get("info_hash"),
            })
        else:
            return jsonify({
                "status": "downloading",
                "downloaded_size": downloaded,
                "total_size": total_size,
                "is_valid": False,
                "complete": is_complete,
                "percent": int(progress * 100),
                "info_hash": current_download.get("info_hash"),
            })

    if video_file:
        file_size = os.path.getsize(video_file)
        valid = is_valid_video_file(video_file)
        if valid:
            return jsonify({
                "status": "ready",
                "file": video_file,
                "downloaded_size": file_size,
                "is_valid": valid,
            })

    return jsonify({"status": "idle", "is_valid": False})

HEADER_MIN_SIZE = 100 * 1024 * 1024  # 100MB minimum

@app.route("/api/download/playable")
def api_download_playable():
    """Check if download is ready to play: needs metadata + min(100MB, filesize)"""
    with download_lock:
        handle = current_download.get("handle")
        if not handle or not handle.is_valid():
            return jsonify({"playable": False, "reason": "no_download"})

        if not handle.has_metadata():
            return jsonify({"playable": False, "reason": "waiting_for_metadata"})

        status = handle.status()
        downloaded = status.total_wanted_done
        file_size = status.total_wanted  # actual movie file size
        min_required = min(HEADER_MIN_SIZE, file_size) if file_size > 0 else HEADER_MIN_SIZE

        if downloaded < min_required:
            return jsonify({
                "playable": False,
                "reason": "insufficient_data",
                "downloaded": downloaded,
                "needed": min_required
            })

        return jsonify({"playable": True, "downloaded": downloaded, "file_size": file_size})

def is_download_active():
    """Check if libtorrent download is still in progress"""
    with download_lock:
        handle = current_download["handle"]
    if handle and handle.is_valid():
        status = handle.status()
        return status.state not in (lt.torrent_status.seeding, lt.torrent_status.finished)
    return False

@app.route("/api/play", methods=["POST"])
def api_play():
    """Start playing the current download with mpv"""
    video_file = find_video_file()
    log_debug(f"[DEBUG play] video_file: {video_file}")

    if not video_file or not os.path.exists(video_file):
        log_debug(f"[DEBUG play] ERROR: No video file found")
        return jsonify({"error": "No video file"}), 404

    valid = is_valid_video_file(video_file)
    file_size = os.path.getsize(video_file) if video_file else 0
    log_debug(f"[DEBUG play] valid: {valid}, file_size: {file_size}")

    if not valid:
        log_debug(f"[DEBUG play] ERROR: Video file not valid")
        return jsonify({"error": "Video file not ready"}), 404

    with mpv_lock:
        if mpv_player["process"]:
            try:
                mpv_player["process"].terminate()
                mpv_player["process"].wait(timeout=5)
            except:
                mpv_player["process"].kill()

        try:
            log_debug(f"[DEBUG play] Starting mpv with: {video_file}")
            proc = subprocess.Popen(
                ["mpv", "--fs", "--keep-open=yes", "--quiet", "--no-terminal",
                 "--vo=gpu", "--hwdec=no", "--force-window=yes",
                 "--demuxer-readahead-secs=30",
                 video_file],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            mpv_player["process"] = proc
            mpv_player["playing"] = True
            mpv_player["title"] = os.path.basename(video_file)
            log_debug(f"[DEBUG play] mpv started successfully")
        except Exception as e:
            log_debug(f"[DEBUG play] ERROR starting mpv: {e}")
            return jsonify({"error": str(e)}), 500

    return jsonify({"status": "playing", "file": video_file})

