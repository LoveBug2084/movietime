    """Get popular movies - uses cache if available, with pagination (100 per page)"""
    page = request.args.get("page", "1")
    try:
        page = int(page)
    except:
        page = 1

    MOVIES_PER_PAGE = 100

    cache_data = load_cached_movies()

    if cache_data:
        all_movies = cache_data.get("movies", [])
        total_movies = len(all_movies)
        total_pages = (total_movies + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE

        start_idx = (page - 1) * MOVIES_PER_PAGE
        end_idx = start_idx + MOVIES_PER_PAGE
        page_movies = all_movies[start_idx:end_idx]

        return jsonify({
            "movies": page_movies,
            "page": page,
            "total_pages": total_pages,
            "cached": True,
            "total_movies": total_movies
        })

    return jsonify({
        "movies": [],
        "page": 1,
        "total_pages": 0,
        "cached": False,
        "total_movies": 0
    })

@app.route("/api/movies/all")
def api_movies_all():
    """Get movies - full from active.json if ?full=1, otherwise from new_movies buffer"""
    global sync_state
    
    want_full = request.args.get("full") == "1"
    
    if want_full:
        # Initial load: read active.json (full database)
        cache_data = load_cached_movies()
        if not cache_data:
            return jsonify({"movies": [], "total": 0})
        movies = cache_data.get("movies", [])
        return jsonify({
            "movies": movies,
            "incremental": False,
            "total": len(movies)
        })
    
    # Poll: swap new_movies files first
    # Ensure files exist before any operation
    if not os.path.exists(NEW_MOVIES_ACTIVE) or not os.path.exists(NEW_MOVIES_BUILDING):
        ensure_new_movies_files()
    
    with new_movies_lock:
        if validate_json_file(NEW_MOVIES_BUILDING):
            new_movies_swap()
        else:
            if os.path.exists(NEW_MOVIES_ACTIVE):
                shutil.copy(NEW_MOVIES_ACTIVE, NEW_MOVIES_BUILDING)
