    """Filter a movie list by genre, rating, year, and title query (same rules the UI applied client-side)"""
    result = []
    query_lower = query.lower() if query else ""
    for m in movies:
        if genre_id and m.get("genre_ids") and genre_id not in m["genre_ids"]:
            continue
        r = m.get("rating")
        if rating_none:
            if r and r != "None" and r != 0:
