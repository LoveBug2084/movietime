    with mpv_lock:
        if mpv_player["process"]:
            try:
                mpv_player["process"].terminate()
                mpv_player["process"].wait(timeout=5)
            except:
                mpv_player["process"].kill()
            mpv_player["process"] = None
            mpv_player["playing"] = False

    with download_lock:
        active_hash = current_download.get("info_hash")
        if active_hash == info_hash:
            handle = current_download.get("handle")
            if handle and handle.is_valid():
                try:
                    lt_session.remove_torrent(handle, True)
                except:
                    pass
            current_download["handle"] = None
            current_download["video_file"] = None
            current_download["info_hash"] = None

    if not os.path.isdir(DOWNLOAD_DIR):
        return jsonify({"error": "Not found"}), 404

    for tmdb_dir in os.listdir(DOWNLOAD_DIR):
        hash_path = os.path.join(DOWNLOAD_DIR, tmdb_dir, info_hash)
        if os.path.isdir(hash_path):
            shutil.rmtree(hash_path)
            tmdb_path = os.path.join(DOWNLOAD_DIR, tmdb_dir)
            if os.path.isdir(tmdb_path) and not os.listdir(tmdb_path):
