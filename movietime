class PyQtBridge(QObject):
    """Bridge object to expose Python functions to JavaScript"""

    def __init__(self, web_view):
        super().__init__()
        self.web_view = web_view

    @pyqtSlot(str)
    def openExternal(self, url):
        """Open URL in external browser"""
        from PyQt5.QtGui import QDesktopServices
        from PyQt5.QtCore import QUrl
        QDesktopServices.openUrl(QUrl(url))


def run_flask():
    """Run Flask server in background thread"""
    app.run(host="0.0.0.0", port=65000, debug=False, use_reloader=False)


def cleanup_on_exit():
    """Stop libtorrent session, mpv player, and restore terminal"""
    global current_download
    with mpv_lock:
        if mpv_player["process"]:
            try:
                mpv_player["process"].terminate()
                mpv_player["process"].wait(timeout=5)
            except:
                mpv_player["process"].kill()
    with download_lock:
        handle = current_download["handle"]
        if handle and handle.is_valid():
            try:
                lt_session.remove_torrent(handle, False)
            except:
                pass
    try:
        import termios
        import sys
        fd = sys.stdin.fileno()
        attrs = termios.tcgetattr(fd)
        termios.tcsetattr(fd, termios.TCSADRAIN, attrs)
        os.system("stty echo")
    except:
        pass


def main():
    """Entry point for desktop app"""
    import sys
    import signal

    flask_thread = threading.Thread(target=run_flask, daemon=True)
    flask_thread.start()

    time.sleep(1)

    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(True)
    app.setApplicationName("MovieTime")

    window = MainWindow()
    window.show()

    shutdown_requested = threading.Event()

    def handle_signal(signum, frame):
        shutdown_requested.set()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Use a QTimer to check shutdown flag from within Qt event loop
    from PyQt5.QtCore import QTimer
    timer = QTimer()
    timer.setInterval(100)
    timer.timeout.connect(lambda: app.quit() if shutdown_requested.is_set() else None)
    timer.start()

    try:
        sys.exit(app.exec_())
    finally:
        cleanup_on_exit()


if __name__ == "__main__":
    main()
