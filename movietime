def torrent_name_years(name):
    """All 4-digit numbers in the name within [1901, current year]"""
    if not name:
        return []
    current_year = int(time.strftime("%Y"))
    return [py for py in re.findall(r'\d{4}', name) if 1901 <= int(py) <= current_year]

def rebuild_combined_final(search_id, query, sort, category, MOVIES_PER_PAGE, year="", genre="", rating=""):
    """Full rebuild with cache + magnetz"""
    global active_searches
    search = active_searches.get(search_id)
    if not search:
        return
    
    tmdb_entries = []
    external_entries = []
    
    # Search local cache
    all_movies = snapshot_movie_db()
    query_lower = query.lower()
    for m in all_movies:
        title = m.get("title", "")
        if query_lower in title.lower():
            copy = dict(m)
            copy["search_source"] = "cache"
            tmdb_entries.append(copy)

    # Always include external results
    if "external_results" not in search:
        apibay_results = search_apibay(query, category, year)
        magnetz_results = search_magnetz(query, category, year)
        search["external_results"] = apibay_results + magnetz_results
    
    all_torrents = search["external_results"]
    # Merge and deduplicate by info_hash
    unique_torrents = {}
    for t in all_torrents:
        ih = t["info_hash"]
        if ih not in unique_torrents:
            unique_torrents[ih] = t
        else:
            # Keep the one with more seeders
            current_seeders = int(t["seeders"]) if t["seeders"].isdigit() else 0
            existing_seeders = int(unique_torrents[ih]["seeders"]) if unique_torrents[ih]["seeders"].isdigit() else 0
            if current_seeders > existing_seeders:
                unique_torrents[ih] = t
                
    combined_torrents = list(unique_torrents.values())
    # Sort by seeders descending
    combined_torrents.sort(key=lambda t: int(t["seeders"]) if t["seeders"].isdigit() else 0, reverse=True)
    
    for m in combined_torrents:
        title = m.get("name", "")
        m["search_source"] = "external"
        m["title"] = title
        m["year"] = ""
        m["rating"] = None
        m["id"] = f"_{zlib.crc32(title.encode()) & 0xFFFFFFFF:08x}"
        external_entries.append(m)

    try:
        genre_id = int(genre) if genre else None
    except:
        genre_id = None
    min_rating = None
    rating_none = rating == "none"
    if rating and not rating_none:
        try:
            min_rating = float(rating)
        except:
            min_rating = None

    if genre_id or min_rating is not None or rating_none or year:
        tmdb_entries = filter_movies(tmdb_entries, genre_id=genre_id, min_rating=min_rating,
                                     rating_none=rating_none, year=year, query="")

    if year:
        kept = []
        for t in external_entries:
            years = torrent_name_years(t.get("name"))
            if not years or year in years:
                kept.append(t)
        external_entries = kept

    combined = tmdb_entries + external_entries

    if sort == "title":
        combined.sort(key=lambda x: (x.get("title") or "").lower())
    elif sort == "year":
        combined.sort(key=lambda x: (x.get("year") or ""), reverse=True)
    elif sort == "description":
        query_lower = query.lower()
        combined = [m for m in combined if query_lower in (m.get("overview") or "").lower()]

    with search["lock"]:
        search["combined"] = combined
        search["total_pages"] = max(1, (len(combined) + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
        search["done"] = True

