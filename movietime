def ensure_database_files():
    """Ensure both movies_active.json and movies_building.json exist"""
    active_exists = os.path.exists(CACHE_FILE)
    building_exists = os.path.exists(BUILDING_FILE)
    
    if not active_exists and not building_exists:
        with open(CACHE_FILE, "w") as f:
            pass
        with open(BUILDING_FILE, "w") as f:
            pass
        print("Created fresh empty database files")
        
    elif not active_exists:
        with open(BUILDING_FILE, "r") as src:
            with open(CACHE_FILE, "w") as dst:
                dst.write(src.read())
        print("Copied building.json to active.json")
        
    elif not building_exists:
        with open(CACHE_FILE, "r") as src:
            with open(BUILDING_FILE, "w") as dst:
                dst.write(src.read())
        print("Copied active.json to building.json")

