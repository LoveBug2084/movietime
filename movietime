def search_year_parallel(year):
    """Search movies by year using parallel requests"""
    MAX_MOVIES = 500
    MAX_PAGES = 25

    first_page = search_year_page(year, 1)
    if not first_page:
        return []

    pages_needed = min(MAX_PAGES, (MAX_MOVIES // 20) + 1)

    futures = {executor.submit(search_year_page, year, page): page for page in range(2, pages_needed + 1)}

    all_movies = []
    for m in first_page:
        year_val = m.get("release_date", "")[:4] if m.get("release_date") else ""
        if year_val == year:
            all_movies.append({
                "id": m.get("id"),
                "title": m.get("title"),
                "poster": TMDB_IMAGE_BASE + m.get("poster_path") if m.get("poster_path") else None,
                "overview": m.get("overview", ""),
                "year": year_val,
                "source": "tmdb"
            })

    for future in as_completed(futures):
        try:
            results = future.result()
            for m in results:
                year_val = m.get("release_date", "")[:4] if m.get("release_date") else ""
                if year_val == year:
                    all_movies.append({
                        "id": m.get("id"),
                        "title": m.get("title"),
                        "poster": TMDB_IMAGE_BASE + m.get("poster_path") if m.get("poster_path") else None,
                        "overview": m.get("overview", ""),
                        "year": year_val,
                        "source": "tmdb"
                    })
        except Exception as e:
            print(f"Error collecting results: {e}")

    return all_movies

import re

def extract_resolution(name):
    """Extract resolution from torrent name"""
    if not name:
        return ""
    patterns = [
        (r'(?i)\b2160p\b', '4K'),
        (r'(?i)\b4[kK]\b', '4K'),
        (r'(?i)\b[Uu][Hh][Dd]\b', '4K'),
        (r'(?i)\b1080p\b', '1080p'),
        (r'(?i)\b720p\b', '720p'),
        (r'(?i)\b480p\b', '480p'),
        (r'(?i)\b360p\b', '360p'),
    ]
    for pattern, label in patterns:
        if re.search(pattern, name):
            return label
    return ""

def score_torrent(name, title, year=""):
    """Score a torrent by how well it matches the movie title and year"""
    if not name or not title:
        return 0

    name_lower = name.lower()
    title_lower = title.lower()

    # Filter out non-movie content
    noise_terms = ["trailer", "review", "soundtrack", "interview", "behind the scenes",
                   "featurette", "making of", "documentary", "short film", "episode",
                   "s01", "s02", "s03", "s04", "s05", "s06", "s07", "s08", "s09", "s10",
                   "season", "complete series", "tv series",
                   "ebook", "audiobook", "kindle", "kobo", "nook",
                   "epub", "mobi", "azw3", "azw", "cbz", "cbr",
                   "mp3", "flac", "m4b", "aax", "ogg", "wma"]
    for noise in noise_terms:
        if noise in name_lower:
            return 0

    # Normalize title: replace special chars with spaces
    title_words = re.sub(r'[^a-z0-9\s]', ' ', title_lower).split()
    name_words = set(re.sub(r'[^a-z0-9\s]', ' ', name_lower).split())

    if not title_words:
        return 0

    # Year filter: Remove if it contains a year DIFFERENT from the selected one
    if year and year.isdigit() and len(year) == 4:
        current_year = int(time.strftime("%Y"))
        potential_years = re.findall(r'\d{4}', name)
        for py in potential_years:
            py_int = int(py)
            if 1900 <= py_int <= current_year:
                if py != year:
                    return 0
    
    # Exact title match (highest score)
    clean_title = re.sub(r'[^a-z0-9\s]', ' ', title_lower).strip()
    clean_name = re.sub(r'[^a-z0-9\s]', ' ', name_lower).strip()
    if clean_title in clean_name or clean_name in clean_title:
        score = 200
    else:
        # Word overlap score
        match_count = sum(1 for w in title_words if w in name_words)
        word_score = int((match_count / len(title_words)) * 100)

        # Year match bonus
        year_bonus = 50 if (year and year.isdigit() and len(year) == 4 and year in name) else 0

        # Resolution bonus
        res_bonus = 0
        if extract_resolution(name):
            res_bonus = 10

        total = word_score + year_bonus + res_bonus

        if match_count >= len(title_words) // 2 + 1:
            score = total
        else:
            score = total if total >= 60 else 0

    return score

def search_apibay(query, category="all", year=""):
    """Search apibay.org for torrents with relevance scoring"""
    category_map = {
        "all": [],
        "movies": ["207"],
        "tv": ["208"],
        "music": ["104", "101"],
        "adult": ["501", "505", "699"]
    }
    allowed_cats = category_map.get(category, [])
    
    # Cache check
    cache_key = (query, category, year)
    now = time.time()
    if cache_key in TORRENT_CACHE["apibay"]:
        timestamp, results = TORRENT_CACHE["apibay"][cache_key]
        if now - timestamp < TORRENT_CACHE_EXPIRATION:
            return results

    try:
        url = f"https://apibay.org/q.php?q={query.replace(' ', '+')}"
        resp = requests.get(url, timeout=10)
        results = resp.json()
        
        if not results or (isinstance(results, list) and len(results) == 0):
            print(f"Empty response from apibay for query: {query}")
            TORRENT_CACHE["apibay"][cache_key] = (now, [])
            return []
        
        torrents = []
        for r in results:
            name = r.get("name", "")
            info_hash = r.get("info_hash", "")
            seeders = r.get("seeders", "0")
            cat = r.get("category", "")
            
            if not info_hash or len(info_hash) != 40:
                continue
            
            if info_hash:
                magnet = f"magnet:?xt=urn:btih:{info_hash}&dn={name}"
                score = score_torrent(name, query, year)
                torrents.append({
                    "name": name,
                    "info_hash": info_hash,
                    "seeders": seeders,
                    "magnet": magnet,
                    "category": cat,
                    "resolution": extract_resolution(name),
                    "size": r.get("size", "0"),
                    "score": score,
                    "source": "apibay"
                })
        
        # Sort by score descending, then by seeders
        torrents.sort(key=lambda t: (t["score"], int(t["seeders"]) if t["seeders"].isdigit() else 0), reverse=True)
        
        # Only return torrents with a positive score
        results = [t for t in torrents if t["score"] > 0][:10]
        TORRENT_CACHE["apibay"][cache_key] = (now, results)
        return results
    except Exception as e:
        print(f"Error searching apibay: {e}")
        return []

def search_magnetz(query, category="all", year=""):
    """Search magnetz.eu for torrents with relevance scoring"""
    # Magnetz doesn't have explicit category IDs like Apibay in the search API
    # but we can filter by name if a category is specified.
    
    # Cache check
    cache_key = (query, category, year)
    now = time.time()
    if cache_key in TORRENT_CACHE["magnetz"]:
        timestamp, results = TORRENT_CACHE["magnetz"][cache_key]
        if now - timestamp < TORRENT_CACHE_EXPIRATION:
            return results

    try:
        # Append year to query for better API results if year is specified
        search_query = query
        if year and year.isdigit() and len(year) == 4:
            search_query = f"{query} {year}"
            
        url = f"https://magnetz.eu/api/magnets/search?query={search_query.replace(' ', '+')}"
        resp = requests.get(url, timeout=10)
        data = resp.json()
        
        # API returns {"data": [...]}
        results = data.get("data", []) if isinstance(data, dict) else (data if isinstance(data, list) else [])
        
        if not results:
            TORRENT_CACHE["magnetz"][cache_key] = (now, [])
            return []
            
        torrents = []
        for r in results:
            name = r.get("name", "")
            info_hash = r.get("info_hash", "")
            seeders = r.get("seeders", 0)
            
            if not info_hash or len(info_hash) != 40:
                continue
                
            magnet = r.get("magnet_link") or f"magnet:?xt=urn:btih:{info_hash}&dn={name}"
            score = score_torrent(name, query, year)
            size = r.get("size", "0")
            
            torrents.append({
                "name": name,
                "info_hash": info_hash,
                "seeders": str(seeders),
                "magnet": magnet,
                "category": "all",
                "resolution": extract_resolution(name),
                "size": str(size),
                "score": score,
                "source": "magnetz"
            })
            
        # Sort by score descending, then by seeders
        torrents.sort(key=lambda t: (t["score"], int(t["seeders"]) if t["seeders"].isdigit() else 0), reverse=True)
        
        # Only return torrents with a positive score
        results = [t for t in torrents if t["score"] > 0][:10]
        TORRENT_CACHE["magnetz"][cache_key] = (now, results)
        return results
    except Exception as e:
        print(f"Error searching magnetz: {e}")
        return []


def search_tmdb_page(query, page):
    """Fetch a single page of search results"""
    url = f"https://api.themoviedb.org/3/search/movie?api_key={TMDB_API_KEY}&query={query}&page={page}"
    try:
        resp = requests.get(url, timeout=10)
        data = resp.json()
        return data.get("results", [])
    except Exception as e:
        print(f"Error fetching search page {page}: {e}")
        return []

# Active streaming searches with background fetching
active_searches = {}

def start_search_background(search_id, query, sort, category, year=""):
    """Background thread that fetches remaining pages for a search"""
    global active_searches
    MAX_MOVIES = 500
    MAX_PAGES = 25
    MOVIES_PER_PAGE = 100

    search = active_searches.get(search_id)
    if not search:
        return

    # Fetch page 1 to get total_pages estimate
    first_page = search_tmdb_page(query, 1)
    if search.get("cancelled"):
        return
    if not first_page:
        with search["lock"]:
            search["done"] = True
        return

    # Process first page
    for m in first_page:
        year_val = m.get("release_date", "")[:4] if m.get("release_date") else ""
        movie = {
            "id": m.get("id"),
            "title": m.get("title"),
            "poster": TMDB_IMAGE_BASE + m.get("poster_path") if m.get("poster_path") else None,
            "overview": m.get("overview", ""),
            "year": year_val,
            "rating": round(m.get("vote_average", 0), 1) if m.get("vote_average") else None,
            "genre_ids": m.get("genre_ids", []),
            "source": "tmdb"
        }
        with search["lock"]:
            search["results"].append(movie)

    total_pages_estimate = min(MAX_PAGES, (MAX_MOVIES // 20) + 1)
    with search["lock"]:
        search["pages_fetched"] = 1
        search["total_pages"] = total_pages_estimate
        search["combined"] = list(search["results"])

    # Fetch remaining pages in batches
    pages_needed = range(2, total_pages_estimate + 1)
    batch_size = 5
    for batch_start in range(0, len(pages_needed), batch_size):
        if search.get("cancelled"):
            break

        batch_end = min(batch_start + batch_size, len(pages_needed))
        batch = pages_needed[batch_start:batch_end]

        futures = {executor.submit(search_tmdb_page, query, page): page for page in batch}

        for future in as_completed(futures):
            if search.get("cancelled"):
                break
            try:
                results = future.result()
                for m in results:
                    year_val = m.get("release_date", "")[:4] if m.get("release_date") else ""
                    movie = {
                        "id": m.get("id"),
                        "title": m.get("title"),
                        "poster": TMDB_IMAGE_BASE + m.get("poster_path") if m.get("poster_path") else None,
                        "overview": m.get("overview", ""),
                        "year": year_val,
                        "rating": round(m.get("vote_average", 0), 1) if m.get("vote_average") else None,
                        "genre_ids": m.get("genre_ids", []),
                        "source": "tmdb"
                    }
                    with search["lock"]:
                        search["results"].append(movie)
                        search["combined"].append(movie)
                with search["lock"]:
                    search["pages_fetched"] += 1
                    search["total_pages"] = max(1, (len(search["combined"]) + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
            except Exception as e:
                print(f"Error collecting search results: {e}")

    # Final full rebuild with cache + magnetz + dedup + sort (only once)
    if search_id in active_searches and not search.get("cancelled"):
        rebuild_combined_final(search_id, query, sort, category, MOVIES_PER_PAGE, year=year)

def rebuild_combined_final(search_id, query, sort, category, MOVIES_PER_PAGE, local_only=False, external_only=False, year=""):
    """Full rebuild with cache + magnetz (skip TMDb if local_only=True, skip cache if external_only=True)"""
    global active_searches
    search = active_searches.get(search_id)
    if not search:
        return
    
    combined = []
    
    # Search local cache - skip if external_only is True
    if not external_only:
        cache_data = load_cached_movies()
        if cache_data:
            all_movies = cache_data.get("movies", [])
            query_lower = query.lower()
            for m in all_movies:
                title = m.get("title", "")
                if query_lower in title.lower():
                    m["search_source"] = "cache"
                    combined.append(m)


    # Only fetch TMDb if not local_only (cache already has TMDb data)
    if not local_only:
        with search["lock"]:
            tmdb_results = list(search["results"])

        for m in tmdb_results:
            m["search_source"] = "tmdb"
            combined.append(m)

    # Always include external results
    if "external_results" not in search:
        apibay_results = search_apibay(query, category, year)
        magnetz_results = search_magnetz(query, category, year)
        search["external_results"] = apibay_results + magnetz_results
    
    all_torrents = search["external_results"]
    # Merge and deduplicate by info_hash
    unique_torrents = {}
    for t in all_torrents:
        ih = t["info_hash"]
        if ih not in unique_torrents:
            unique_torrents[ih] = t
        else:
            # Keep the one with more seeders
            current_seeders = int(t["seeders"]) if t["seeders"].isdigit() else 0
            existing_seeders = int(unique_torrents[ih]["seeders"]) if unique_torrents[ih]["seeders"].isdigit() else 0
            if current_seeders > existing_seeders:
                unique_torrents[ih] = t
                
    combined_torrents = list(unique_torrents.values())
    # Sort by score then seeders
    combined_torrents.sort(key=lambda t: (t["score"], int(t["seeders"]) if t["seeders"].isdigit() else 0), reverse=True)
    
    for m in combined_torrents:
        title = m.get("name", "")
        m["search_source"] = "external"
        m["title"] = title
        m["year"] = ""
        m["rating"] = None
        combined.append(m)

    if sort == "title":
        combined.sort(key=lambda x: (x.get("title") or "").lower())
    elif sort == "year":
        combined.sort(key=lambda x: (x.get("year") or ""), reverse=True)
    elif sort == "description":
        query_lower = query.lower()
        combined = [m for m in combined if query_lower in (m.get("overview") or "").lower()]

    with search["lock"]:
        search["combined"] = combined
        search["total_pages"] = max(1, (len(combined) + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
        search["done"] = True

