@app.route("/api/play", methods=["POST"])
def api_play():
    """Start playing the current download with mpv"""
    video_file = find_video_file()

    if not video_file or not os.path.exists(video_file):
        return jsonify({"error": "No video file"}), 404

    if not is_valid_video_file(video_file):
        return jsonify({"error": "Video file not ready"}), 404

    with mpv_lock:
        if mpv_player["process"]:
            try:
                mpv_player["process"].terminate()
                mpv_player["process"].wait(timeout=5)
            except:
                mpv_player["process"].kill()

        try:
            proc = subprocess.Popen(
                ["mpv", "--fs", "--keep-open=yes", "--quiet", "--no-terminal",
                 "--vo=gpu", "--hwdec=no", "--force-window=yes",
                 "--demuxer-readahead-secs=30",
                 video_file],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            mpv_player["process"] = proc
            mpv_player["playing"] = True
            mpv_player["title"] = os.path.basename(video_file)
        except Exception as e:
            return jsonify({"error": str(e)}), 500

    return jsonify({"status": "playing", "file": video_file})

