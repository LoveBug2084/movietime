@app.route("/api/status")
def api_status():
    """Check download status with progress using libtorrent"""
    # First check if we have a stored video_file that still exists
    with download_lock:
        stored_file = current_download.get("video_file")
        info_hash = current_download.get("info_hash")
        tmdb_id = current_download.get("tmdb_id")
    
    video_file = None
    if stored_file and os.path.exists(stored_file) and os.path.getsize(stored_file) > 0:
        if is_valid_video_file(stored_file):
            video_file = stored_file
    
    # Fallback to searching for video files
    if not video_file and info_hash:
        video_file = find_video_file(info_hash, tmdb_id)

    with download_lock:
        handle = current_download["handle"]

    if handle and handle.is_valid():
        status = handle.status()
        downloaded = status.total_wanted_done
        state = status.state

        is_downloading = state not in (lt.torrent_status.seeding, lt.torrent_status.finished)
        is_complete = state in (lt.torrent_status.seeding, lt.torrent_status.finished)

        # Update video_file reference from libtorrent
        if not video_file and is_complete and info_hash:
            video_file = find_video_file(info_hash, tmdb_id)
            if video_file:
                with download_lock:
                    current_download["video_file"] = video_file

        if video_file:
            file_size = os.path.getsize(video_file)
            valid = is_valid_video_file(video_file)

            if is_complete and valid:
                ih = current_download.get("info_hash")
                return jsonify({
                    "status": "ready",
                    "file": video_file,
                    "downloaded_size": file_size,
                    "is_valid": valid,
                    "info_hash": ih,
                    "tmdb_id": tmdb_id,
                })

            ih = current_download.get("info_hash")
            return jsonify({
                "status": "downloading",
                "downloaded_size": downloaded,
                "total_size": status.total_wanted,
                "is_valid": valid,
                "complete": is_complete,
                "info_hash": ih,
                "tmdb_id": tmdb_id,
            })
        else:
            ih = current_download.get("info_hash")
            return jsonify({
                "status": "downloading",
                "downloaded_size": downloaded,
                "total_size": status.total_wanted,
                "is_valid": False,
                "complete": is_complete,
                "info_hash": ih,
                "tmdb_id": tmdb_id,
            })

    if video_file:
        file_size = os.path.getsize(video_file)
        valid = is_valid_video_file(video_file)
        if valid:
            ih = current_download.get("info_hash")
            # Check if the file is actually fully downloaded
            status_data = get_torrent_status(tmdb_id, ih) if ih else None
            if status_data and status_data.get("progress", 0) < 100:
                return jsonify({
                    "status": "downloading",
                    "downloaded_size": status_data.get("downloaded_bytes", file_size),
                    "total_size": status_data.get("total_bytes", file_size),
                    "is_valid": valid,
                    "complete": False,
                    "info_hash": ih,
                    "tmdb_id": tmdb_id,
                })
            return jsonify({
                "status": "ready",
                "file": video_file,
                "downloaded_size": file_size,
                "is_valid": valid,
                "info_hash": ih,
                "tmdb_id": tmdb_id,
            })

    if last_cancel_reason["reason"] and time.time() - last_cancel_reason["timestamp"] < 10:
        return jsonify({
            "status": "cancelled",
            "is_valid": False,
            "cancel_reason": last_cancel_reason["reason"],
            "info_hash": last_cancel_reason["info_hash"],
        })

    return jsonify({"status": "idle", "is_valid": False})

HEADER_MIN_PERCENT = 0.04  # 4% of file size minimum

@app.route("/api/download/playable")
def api_download_playable():
    """Check if download is ready to play: needs metadata + 4% of filesize"""
    with download_lock:
        handle = current_download.get("handle")
        if not handle or not handle.is_valid():
            return jsonify({"playable": False, "reason": "no_download"})

        if not handle.has_metadata():
            return jsonify({"playable": False, "reason": "waiting_for_metadata"})

        status = handle.status()
        downloaded = status.total_wanted_done
        file_size = status.total_wanted  # actual movie file size
        min_required = int(file_size * HEADER_MIN_PERCENT) if file_size > 0 else 0

        if downloaded < min_required:
            return jsonify({
                "playable": False,
                "reason": "insufficient_data",
                "downloaded": downloaded,
                "needed": min_required
            })

        info_hash = current_download.get("info_hash")
        tmdb_id = current_download.get("tmdb_id")
        video_file = find_video_file(info_hash, tmdb_id)
        if not video_file or not is_valid_video_file(video_file):
            return jsonify({"playable": False, "reason": "video_not_ready"})

        return jsonify({"playable": True, "downloaded": downloaded, "file_size": file_size})

