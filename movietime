# Active streaming searches with background fetching
active_searches = {}
search_cleanup_timer = None

def start_search_background(search_id, query, sort, category):
    """Background thread that fetches remaining pages for a search"""
    global active_searches
    MAX_MOVIES = 500
    MAX_PAGES = 25
    MOVIES_PER_PAGE = 100

    search = active_searches.get(search_id)
    if not search:
        return

    # Fetch page 1 to get total_pages estimate
    first_page = search_tmdb_page(query, 1)
    if search.get("cancelled"):
        return
    if not first_page:
        with search["lock"]:
            search["done"] = True
        return

    # Process first page
    for m in first_page:
        year_val = m.get("release_date", "")[:4] if m.get("release_date") else ""
        movie = {
            "id": m.get("id"),
            "title": m.get("title"),
            "poster": TMDB_IMAGE_BASE + m.get("poster_path") if m.get("poster_path") else None,
            "overview": m.get("overview", ""),
            "year": year_val,
            "rating": round(m.get("vote_average", 0), 1) if m.get("vote_average") else None,
            "source": "tmdb"
        }
        with search["lock"]:
            search["results"].append(movie)

    total_pages_estimate = min(MAX_PAGES, (MAX_MOVIES // 20) + 1)
    with search["lock"]:
        search["pages_fetched"] = 1
        search["total_pages"] = total_pages_estimate
        search["combined"] = list(search["results"])

    # Fetch remaining pages in batches
    pages_needed = range(2, total_pages_estimate + 1)
    batch_size = 5
    for batch_start in range(0, len(pages_needed), batch_size):
        if search.get("cancelled"):
            break

        batch_end = min(batch_start + batch_size, len(pages_needed))
        batch = pages_needed[batch_start:batch_end]

        futures = {executor.submit(search_tmdb_page, query, page): page for page in batch}

        for future in as_completed(futures):
            if search.get("cancelled"):
                break
            try:
                results = future.result()
                for m in results:
                    year_val = m.get("release_date", "")[:4] if m.get("release_date") else ""
                    movie = {
                        "id": m.get("id"),
                        "title": m.get("title"),
                        "poster": TMDB_IMAGE_BASE + m.get("poster_path") if m.get("poster_path") else None,
                        "overview": m.get("overview", ""),
                        "year": year_val,
                        "rating": round(m.get("vote_average", 0), 1) if m.get("vote_average") else None,
                        "source": "tmdb"
                    }
                    with search["lock"]:
                        search["results"].append(movie)
                        search["combined"].append(movie)
                with search["lock"]:
                    search["pages_fetched"] += 1
                    search["total_pages"] = max(1, (len(search["combined"]) + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
            except Exception as e:
                print(f"Error collecting search results: {e}")

    # Final full rebuild with cache + apibay + dedup + sort (only once)
    if search_id in active_searches and not search.get("cancelled"):
        rebuild_combined_final(search_id, query, sort, category, MOVIES_PER_PAGE)

def rebuild_combined_final(search_id, query, sort, category, MOVIES_PER_PAGE):
    """Full rebuild with cache + tmdb + apibay - only called once when streaming is done"""
    global active_searches
    search = active_searches.get(search_id)
    if not search:
        return

    with search["lock"]:
        tmdb_results = list(search["results"])

    seen_titles = set()
    combined = []

    cache_data = load_cached_movies()
    if cache_data:
        all_movies = cache_data.get("movies", [])
        query_lower = query.lower()
        for m in all_movies:
            title = m.get("title", "")
            if query_lower in title.lower():
                m["search_source"] = "cache"
                normalized = title.lower().strip()
                if normalized not in seen_titles:
                    seen_titles.add(normalized)
                    combined.append(m)

    for m in tmdb_results:
        title = m.get("title", "")
        normalized = title.lower().strip()
        if normalized not in seen_titles:
            seen_titles.add(normalized)
            m["search_source"] = "tmdb"
            combined.append(m)

    apibay_results = search_apibay(query, category)
    for m in apibay_results:
        title = m.get("name", "")
        normalized = title.lower().strip()
        if normalized not in seen_titles:
            seen_titles.add(normalized)
            m["search_source"] = "apibay"
            m["title"] = title
            m["year"] = ""
            m["rating"] = None
            combined.append(m)

    if sort == "title":
        combined.sort(key=lambda x: (x.get("title") or "").lower())
    elif sort == "year":
        combined.sort(key=lambda x: (x.get("year") or ""), reverse=True)
    elif sort == "description":
        query_lower = query.lower()
        combined = [m for m in combined if query_lower in (m.get("overview") or "").lower()]

    with search["lock"]:
        search["combined"] = combined
        search["total_pages"] = max(1, (len(combined) + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
        search["done"] = True

def cleanup_old_searches():
    """Remove searches older than 5 minutes"""
    global active_searches
    now = time.time()
    to_remove = [sid for sid, s in active_searches.items() if now - s["created"] > 300]
    for sid in to_remove:
        del active_searches[sid]

def cleanup_timer_loop():
    while True:
        time.sleep(60)
        cleanup_old_searches()

