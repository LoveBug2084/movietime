        if new_movies_data:
            with db_lock:
                append_to_building(new_movies_data)
                if validate_json_file(BUILDING_FILE):
                    atomic_swap_and_sync()
                    append_to_building(new_movies_data)
                else:
                    recover_from_corruption()
            
            main_movies = load_json_file(CACHE_FILE)
            total_in_database = len(main_movies) if main_movies else 0
        
        with open(NEW_MOVIES_BUILDING, "w") as f:
            pass
        
        return jsonify({
            "movies": new_movies_data,
            "incremental": True,
            "total": total_in_database
        })

@app.route("/api/search")
def api_search():
    """Search movies with streaming results - page 1 returned immediately, rest fetched in background"""
    query = request.args.get("q", "").strip()
    year = request.args.get("year", "").strip()
    sort = request.args.get("sort", "all").strip()
    category = request.args.get("category", "all").strip()
    page = request.args.get("page", "1").strip()
    external_only = request.args.get("external_only", "0") == "1"
    try:
        page = int(page)
    except:
        page = 1
    
    MOVIES_PER_PAGE = 100
    
    if category in ["tv", "music", "adult", "movies"]:
        all_results = search_apibay(query, category, year) + search_magnetz(query, category, year)
        total_results = len(all_results)
        total_pages = max(1, (total_results + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
        start_idx = (page - 1) * MOVIES_PER_PAGE
        end_idx = start_idx + MOVIES_PER_PAGE
        return jsonify({
            "results": all_results[start_idx:end_idx],
            "page": page,
            "total_pages": total_pages,
            "total_results": total_results,
            "sources": {"magnetz": total_results},
            "streaming": False
        })
    
    if not query and not year:
        all_movies = get_popular_movies().get("movies", [])
        total_results = len(all_movies)
        total_pages = max(1, (total_results + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
        start_idx = (page - 1) * MOVIES_PER_PAGE
        end_idx = start_idx + MOVIES_PER_PAGE
        return jsonify({
            "results": all_movies[start_idx:end_idx],
            "page": page,
            "total_pages": total_pages,
            "total_results": total_results,
            "sources": {"popular": total_results},
            "streaming": False
        })
    
    if not query and year and year.isdigit() and len(year) == 4:
        all_results = search_year_parallel(year)
        total_results = len(all_results)
        total_pages = max(1, (total_results + MOVIES_PER_PAGE - 1) // MOVIES_PER_PAGE)
        start_idx = (page - 1) * MOVIES_PER_PAGE
        end_idx = start_idx + MOVIES_PER_PAGE
        return jsonify({
            "results": all_results[start_idx:end_idx],
            "page": page,
            "total_pages": total_pages,
            "total_results": total_results,
            "sources": {"tmdb": total_results},
            "streaming": False
        })
    
    # Search - default to local-only (cache + magnetz), skip TMDb
    local_only = request.args.get("local", "1") != "0"
    import uuid
    search_id = str(uuid.uuid4())
    
    # Get total database count - skip if external_only
    total_database = 0
    if not external_only:
        cache_data = load_cached_movies()
        total_database = len(cache_data.get("movies", [])) if cache_data else 0
    
    # Cancel any previous active searches (frontend should handle this, but safety net)
    for sid in list(active_searches.keys()):
        active_searches[sid]["cancelled"] = True
    
    # Create search entry
    active_searches[search_id] = {
        "results": [],
        "pages_fetched": 0,
        "total_pages": 0,
        "done": False,
        "cancelled": False,
        "lock": threading.Lock(),
        "created": time.time()
    }
    
    # Only fetch TMDb if not local_only
    if not local_only:
        # Start background fetcher
        threading.Thread(
            target=start_search_background,
            args=(search_id, query, sort, category, year),
            daemon=True
        ).start()
        
        # Wait briefly for first page to populate
        # time.sleep(1.5)
        
        with active_searches[search_id]["lock"]:
            search = active_searches[search_id]
            pages_fetched = search["pages_fetched"]
            done = search["done"]
            combined_results = list(search.get("combined", []))
    else:
        # Local-only search: immediately build combined results from cache
        pages_fetched = 0
        done = True
        combined_results = []
        with active_searches[search_id]["lock"]:
            search = active_searches[search_id]
            search["done"] = True
            # Initialize combined for rebuild_combined_final
            search["combined"] = []
    
    # Build final combined results
    rebuild_combined_final(search_id, query, sort, category, MOVIES_PER_PAGE, local_only, external_only, year=year)
    
    with active_searches[search_id]["lock"]:
        search = active_searches[search_id]
        combined_results = list(search.get("combined", []))
    
    total_results = len(combined_results)
    total_pages = search["total_pages"]
    start_idx = (page - 1) * MOVIES_PER_PAGE
    end_idx = start_idx + MOVIES_PER_PAGE
    page_results = combined_results[start_idx:end_idx]
    
    return jsonify({
        "results": page_results,
        "page": page,
        "total_pages": total_pages,
        "total_results": total_results,
        "total_database": total_database,
        "search_id": search_id,
        "pages_fetched": pages_fetched,
        "done": done,
        "streaming": True,
        "combined": combined_results,
        "sources": {
            "cache": 0,
            "tmdb": total_results,
            "magnetz": 0
        }
    })


@app.route("/api/search/page")
def api_search_page():
    """Get a specific page from an existing search - instant, no new search"""
    search_id = request.args.get("id", "").strip()
    page = request.args.get("page", "1").strip()
    try:
        page = int(page)
    except:
        page = 1

    MOVIES_PER_PAGE = 100

    if not search_id or search_id not in active_searches:
        return jsonify({"error": "Search not found"}), 404

    search = active_searches[search_id]
    with search["lock"]:
        combined = search.get("combined", [])
        total_pages = search["total_pages"]
        pages_fetched = search["pages_fetched"]
        done = search["done"]

    start_idx = (page - 1) * MOVIES_PER_PAGE
    end_idx = start_idx + MOVIES_PER_PAGE
    page_results = combined[start_idx:end_idx]

    return jsonify({
        "results": page_results,
        "page": page,
        "total_pages": total_pages,
        "total_results": len(combined),
        "pages_fetched": pages_fetched,
        "done": done
    })

