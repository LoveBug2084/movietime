def load_movies_from_cache():
    """Load movies from cache file and populate movie_ids set"""
    global movie_ids, movie_count
    
    ensure_database_files()
    recover_from_corruption()
    
    active_movies = load_json_file(CACHE_FILE)
    if active_movies:
        movie_ids = {m["id"] for m in active_movies if "id" in m}
        movie_count = len(active_movies)
        print(f"Loaded {len(active_movies)} movies from cache, {len(movie_ids)} unique IDs")
        return active_movies
    
    building_movies = load_json_file(BUILDING_FILE)
    if building_movies:
        movie_ids = {m["id"] for m in building_movies if "id" in m}
        movie_count = len(building_movies)
        print(f"Loaded {len(building_movies)} movies from building, {len(movie_ids)} unique IDs")
        return building_movies
    
    movie_count = 0
    return []

def load_sync_state():
    """Load sync state from file"""
    global sync_state
    if not os.path.exists(SYNC_STATE_FILE):
        return
    try:
        with open(SYNC_STATE_FILE, "r") as f:
            loaded = json.load(f)
            sync_state = {
                "genre_index": loaded.get("genre_index", 0),
                "last_updated": loaded.get("last_updated"),
                "status": loaded.get("status", "idle"),
                "current_page": loaded.get("current_page", 1)
            }
    except Exception as e:
        print(f"Error loading sync state: {e}")

def save_sync_state():
    """Save sync state to file"""
    try:
        with open(SYNC_STATE_FILE, "w") as f:
            json.dump(sync_state, f)
    except Exception as e:
        print(f"Error saving sync state: {e}")

def append_to_building(new_movies):
    """Append new movies to building.json as line-delimited JSON"""
    try:
        with open(BUILDING_FILE, "a") as f:
            for movie in new_movies:
                f.write(json.dumps(movie) + "\n")
    except Exception as e:
        print(f"Error appending to building: {e}")

def validate_json_file(filepath):
    """Check if a file contains valid JSON (line-delimited)"""
    if not os.path.exists(filepath):
        return False
    try:
        with open(filepath, "r") as f:
            content = f.read()
            # Empty file is valid (starts fresh)
            if not content:
                return True
            for line in content.split('\n'):
                line = line.strip()
                if line:
                    json.loads(line)
            return True
    except Exception as e:
        print(f"Validation failed for {filepath}: {e}")
        return False

def load_json_file(filepath):
    """Load movies from line-delimited JSON"""
    if not os.path.exists(filepath):
        return []
    movies = []
    bad_lines = 0
    with open(filepath, "r") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                movies.append(json.loads(line))
            except Exception:
                bad_lines += 1
    if bad_lines:
        print(f"Skipped {bad_lines} bad lines in {filepath}")
    return movies

def atomic_swap_and_sync():
    """Atomic swap: building → active, active → building, then append new movies to building"""
    ensure_database_files()
    
    temp_active = CACHE_FILE + ".tmp"
    try:
        os.replace(CACHE_FILE, temp_active)
        os.replace(BUILDING_FILE, CACHE_FILE)
        os.replace(temp_active, BUILDING_FILE)
    except Exception as e:
        print(f"Swap failed: {e}")
        if os.path.exists(temp_active):
            os.replace(temp_active, CACHE_FILE)

def new_movies_swap():
    """Atomic swap: new_movies_building → new_movies_active"""
    ensure_new_movies_files()
    
    temp = NEW_MOVIES_ACTIVE + ".tmp"
    try:
        os.replace(NEW_MOVIES_ACTIVE, temp)
        os.replace(NEW_MOVIES_BUILDING, NEW_MOVIES_ACTIVE)
        os.replace(temp, NEW_MOVIES_BUILDING)
    except Exception as e:
        print(f"New movies swap failed: {e}")
        if os.path.exists(temp):
            os.replace(temp, NEW_MOVIES_ACTIVE)

def recover_from_corruption():
    """If one file is corrupted, copy from the other"""
    active_valid = validate_json_file(CACHE_FILE)
    building_valid = validate_json_file(BUILDING_FILE)
    
    if active_valid and not building_valid:
        movies = load_json_file(CACHE_FILE)
        with open(BUILDING_FILE, "w") as f:
            for m in movies:
                f.write(json.dumps(m) + "\n")
        print(f"Recovered building.json from active.json")
    elif not active_valid and building_valid:
        movies = load_json_file(BUILDING_FILE)
        with open(CACHE_FILE, "w") as f:
            for m in movies:
                f.write(json.dumps(m) + "\n")
        print(f"Recovered active.json from building.json")
    elif not active_valid and not building_valid:
        print("WARNING: Both files corrupted!")

def background_sync():
    """Background thread that syncs movies from TMDB using async parallel fetching"""
    global sync_state, movie_ids
    print("Starting background movie sync...")
    
    load_movies_from_cache()
    load_sync_state()
    print(f"Loaded sync_state: {sync_state}")

    genre_index = sync_state.get("genre_index", 0)

    sync_state["status"] = "running"
    save_sync_state()
    
    while not sync_stop_event.is_set():
        page = sync_state.get("current_page", 1)
        genre_index = sync_state.get("genre_index", 0)
        genre_id = GENRE_IDS[genre_index]

        if genre_id == 0:
            movies, total_pages = fetch_movie_page(page)
        else:
            movies, total_pages = fetch_movie_by_genre(genre_id, page)
        
        new_movies = []
        for m in movies:
            if m["id"] not in movie_ids:
                movie_ids.add(m["id"])
                new_movies.append(m)
        
        genre_name = GENRE_NAMES[GENRE_IDS[genre_index]]
        phase_label = f"{genre_name.ljust(15)}, Page {page:>3}/500, {len(new_movies):>2} new"

        if new_movies:
            print(f"{phase_label}")
            with db_lock:
                append_to_building(new_movies)
                
                if validate_json_file(BUILDING_FILE):
                    atomic_swap_and_sync()
                    append_to_building(new_movies)
                else:
                    recover_from_corruption()
                    append_to_building(new_movies)
            
            global movie_count
            movie_count += len(new_movies)

        genre_index += 1
        if genre_index >= len(GENRE_IDS):
            genre_index = 0
            page += 1
            if page > 500:
                page = 1
                print("Completed full cycle, restarting...")

        sync_state["current_page"] = page
        sync_state["genre_index"] = genre_index
        sync_state["last_updated"] = time.time()
        save_sync_state()
        
        if sync_stop_event.is_set():
            break
        
        time.sleep(SYNC_RATE_LIMIT)
    
    sync_state["status"] = "stopped"
    save_sync_state()
    print("Background sync stopped.")

