def apply_sequential_priority(handle):
    """Prioritize the video file's pieces so the header downloads first.
    Must be called AFTER metadata has been received.
    Sets non-video files to dont_download and prioritizes video file pieces.
    """
    ti = handle.get_torrent_info()
    if not ti:
        print("Warning: No torrent info available for piece priority")
        return False

    video_exts = {".mp4", ".mkv", ".avi", ".webm", ".mov"}
    best_file = None
    best_size = 0

    files = ti.files()
    for i in range(len(files)):
        f = files[i]
        ext = os.path.splitext(f.path)[-1].lower()
        if ext in video_exts and f.size > best_size:
            best_file = i
            best_size = f.size

    if best_file is None:
        print("Warning: No video file found in torrent, downloading all files")
        return False

    num_pieces = ti.num_pieces()
    piece_length = ti.piece_length()

    # In libtorrent 2.x, file offset is stored on the file_entry
    file_offset = files[best_file].offset
    file_size = files[best_file].size

    # Map the video file's byte range to pieces
    video_start_piece = file_offset // piece_length
    video_end_piece = (file_offset + file_size + piece_length - 1) // piece_length
    video_end_piece = min(video_end_piece, num_pieces)

    # STEP 1: Set all non-video files to dont_download FIRST
    for i in range(len(files)):
        if i != best_file:
            handle.file_priority(i, lt.download_priority_t.dont_download)

    # Set the video file to normal priority
    handle.file_priority(best_file, lt.download_priority_t.normal_priority)

    # STEP 2: Now set piece priorities
    # First, set ALL pieces to priority 0 (don't download)
    for i in range(num_pieces):
        handle.piece_priority(i, 0)

    # STEP 3: Set video file pieces to priority 5 (normal)
    for i in range(video_start_piece, video_end_piece):
        handle.piece_priority(i, 5)

    # STEP 4: Prioritize the first 10 pieces of the video file (header/metadata)
    header_count = min(10, video_end_piece - video_start_piece)
    for i in range(video_start_piece, video_start_piece + header_count):
        handle.piece_priority(i, 7)

    video_file_name = files[best_file].path
    print(f"Applied sequential priority: '{video_file_name}' ({best_size / (1024*1024):.1f} MB)")
    print(f"  Video pieces: {video_start_piece} to {video_end_piece} (of {num_pieces} total)")
    print(f"  Header pieces: {video_start_piece} to {video_start_piece + header_count}")
    print(f"  Non-video files set to dont_download: {len(files) - 1} files")

    return True

def download_torrent(magnet_link, info_hash, name):
    """Download torrent using libtorrent with sequential piece priority"""
    global current_download

    with download_lock:
        # Pause any existing download (keep data so it can resume later)
        if current_download["handle"]:
            try:
                lt_session.remove_torrent(current_download["handle"], False)
            except:
                pass

    # Build magnet link with trackers
    tracker_params = "&tr=".join(PUBLIC_TRACKERS)
    if tracker_params:
        magnet_link = magnet_link + "&tr=" + tracker_params

    print(f"Starting libtorrent download: {magnet_link[:80]}...")

    atp = lt.parse_magnet_uri(magnet_link)
    atp.save_path = os.path.abspath(DOWNLOAD_DIR)
    atp.storage_mode = lt.storage_mode_t.storage_mode_sparse

    handle = lt_session.add_torrent(atp)

    with download_lock:
        current_download["handle"] = handle
        current_download["info_hash"] = info_hash
        current_download["name"] = name
        current_download["video_file"] = None

    download_progress[info_hash] = {
        "name": name,
        "total_size": 0,
        "downloaded": 0,
        "percent": 0,
        "state": "downloading",
    }

    # For magnet links, metadata must be downloaded first.
    # Poll until metadata arrives, then apply piece priorities.
    def wait_for_metadata_and_apply():
        for _ in range(120):  # wait up to 60 seconds
            time.sleep(0.5)
            if handle.has_metadata():
                apply_sequential_priority(handle)
                print(f"Metadata received, sequential priority applied for: {name}")
                return
        print(f"Warning: metadata not received within 60s for: {name}")

    threading.Thread(target=wait_for_metadata_and_apply, daemon=True).start()

def track_download_progress():
    """Background thread that updates download_progress dict"""
    while True:
        time.sleep(2)
        with download_lock:
            handle = current_download["handle"]
            if handle and handle.is_valid():
                status = handle.status()
                total_size = status.total_wanted
                downloaded = status.total_wanted_done
                info_hash = current_download["info_hash"]
                name = current_download["name"] or "Unknown"

                if total_size > 0:
                    download_progress[info_hash] = {
                        "name": name,
                        "total_size": total_size,
                        "downloaded": downloaded,
                        "percent": int((downloaded / total_size) * 100),
                        "state": "downloading",
                    }
                else:
                    download_progress[info_hash] = {
                        "name": name,
                        "total_size": total_size,
                        "downloaded": downloaded,
                        "percent": 0,
                        "state": "downloading",
                    }

# Start the tracking thread
threading.Thread(target=track_download_progress, daemon=True).start()

def find_video_file():
    """Find the most recent video file in download directory (including subdirectories)"""
    video_exts = [".mp4", ".mkv", ".avi", ".webm", ".mov"]
    newest_file = None
    newest_time = 0

    for root, dirs, files in os.walk(DOWNLOAD_DIR):
        for f in files:
            ext = os.path.splitext(f)[1].lower()
            if ext in video_exts:
                full_path = os.path.join(root, f)
                if os.path.getsize(full_path) > 0:
                    mtime = os.path.getmtime(full_path)
                    if mtime > newest_time:
                        newest_time = mtime
                        newest_file = full_path

    return newest_file

def is_valid_video_file(file_path):
    """Check if file has a valid video header"""
    if not file_path or not os.path.exists(file_path):
        return False

    try:
        file_size = os.path.getsize(file_path)
        if file_size < 1024:
            return False

        with open(file_path, "rb") as f:
            header = f.read(4096)

        if len(header) < 4:
            return False

        if header[:4] == b'\x1a\x45\xdf\xa3':
            return True

        if header[:4] == b'RIFF':
            return True

        if header[4:8] == b'ftyp':
            return True

        for i in range(len(header) - 4):
            if header[i:i+4] == b'\x00\x00\x00\x01':
                return True

        non_zero = sum(1 for b in header if b != 0)
        if non_zero < len(header) * 0.1:
            return False

        return True

    except Exception as e:
        print(f"Error checking video file: {e}")
        return False

